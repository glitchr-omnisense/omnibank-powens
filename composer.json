{
    "name": "omnibank/powens",
    "type": "library",
    "description": "Omnibank Powens: bank aggregation through Powens (ex Budget Insight) - its Webview for the consent, accounts, balances, transactions, CONNECTION_SYNCED webhooks.",
    "keywords": ["bank", "open banking", "psd2", "powens", "budget insight", "omnibank"],
    "license": "MIT",
    "authors": [{"name": "Marco Meyer", "email": "marco.meyer@glitchr.io"}],
    "require": {
        "php": ">=8.2",
        "omniscient/omnibank": "^1.0@dev",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "require-dev": {"phpunit/phpunit": "^11.0"},
    "autoload": {"psr-4": {"Omnibank\\Powens\\": ""}, "exclude-from-classmap": ["/Tests/"]},
    "autoload-dev": {"psr-4": {"Omnibank\\Powens\\Tests\\": "Tests/"}},
    "config": {"sort-packages": true}
}
